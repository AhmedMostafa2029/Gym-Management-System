<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Power Fitness | @ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>

<body class="app-body">

    @* ==================== Navigation ==================== *@

    <header class="app-header">

        <nav class="navbar navbar-expand-xl app-navbar">

            <div class="container">

                @* Brand *@

                <a class="navbar-brand app-brand"
                       asp-controller="Home"
                       asp-action="Index">

                    <img src="~/images/logo.jpg"
                         alt="Power Fitness Logo"
                         class="app-logo" />

                </a>


                @* Mobile Toggle *@

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavigation">


                    @* ==================== Main Navigation ==================== *@

                    <ul class="navbar-nav app-navigation mx-auto">

                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                <i class="bi bi-grid me-1"></i>

                                Dashboard

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Member"
                                   asp-action="Index">

                                <i class="bi bi-people me-1"></i>

                                Members

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Trainer"
                                   asp-action="Index">

                                <i class="bi bi-person-badge me-1"></i>

                                Trainers

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Session"
                                   asp-action="Index">

                                <i class="bi bi-calendar-event me-1"></i>

                                Sessions

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Plan"
                                   asp-action="Index">

                                <i class="bi bi-clipboard-data me-1"></i>

                                Plans

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Membership"
                                   asp-action="Index">

                                <i class="bi bi-card-checklist me-1"></i>

                                Memberships

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                                   asp-controller="Booking"
                                   asp-action="Index">

                                <i class="bi bi-journal-check me-1"></i>

                                Bookings

                            </a>

                        </li>

                    </ul>


                    @* ==================== Account ==================== *@

                    <div class="app-account">

                        <div class="dropdown">

                            <button class="app-account-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="app-account-avatar">

                                    <i class="bi bi-person"></i>

                                </span>

                                <span class="app-account-info">

                                    <span class="app-account-name">
                                        Account
                                    </span>

                                    <small>
                                        Management
                                    </small>

                                </span>

                                <i class="bi bi-chevron-down app-account-arrow"></i>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end app-account-menu">

                                <li>

                                    <span class="dropdown-header">

                                        Power Fitness System

                                    </span>

                                </li>


                                <li>

                                    <hr class="dropdown-divider" />

                                </li>


                                <li>

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item app-logout-button">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    @* ==================== Main Content ==================== *@

    <main class="app-main">

        <div class="container">

            @RenderBody()

        </div>

    </main>


    @* ==================== Footer ==================== *@

    <footer class="app-footer">

        <div class="container">

            <div class="app-footer-content">

                <div>

                    <strong>
                        Power Fitness
                    </strong>

                    <span>
                        Management System
                    </span>

                </div>

                <p>
                    &copy; @DateTime.Now.Year Power Fitness
                </p>

            </div>

        </div>

    </footer>


    @* ==================== Scripts ==================== *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>